# ========================================================
# Garment Shop Management System - Environment Variables (MongoDB)
# ========================================================

# Deployment Environment
NODE_ENV=development
PORT=3000

# MongoDB Database Connection URI
# For MongoDB Atlas (Cloud Production):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/garment_shop_erp?retryWrites=true&w=majority
#
# For Local MongoDB service:
# MONGODB_URI=mongodb://127.0.0.1:27017/garment_shop_erp
#
# Local development may use an embedded MongoDB only when MONGODB_URI is omitted.
# Production requires a persistent MongoDB URI; it never falls back to in-memory storage.
MONGODB_URI=mongodb://127.0.0.1:27017/garment_shop_erp

# Session and Security Secrets (Set to a long, cryptographically random secret string)
SESSION_SECRET=replace_with_a_random_secret_at_least_32_characters_long

# Optional initial Super Admin provisioning. Uncomment and replace all values before use.
# ADMIN_EMAIL=owner@example.com
# ADMIN_PASSWORD=replace_with_a_unique_password_at_least_12_characters
# ADMIN_USERNAME=owner_admin

# Protected Remote Setup Token (Optional)
# Required in production to authorize remote first-time administrator provisioning or recovery.
# SETUP_TOKEN=replace_with_a_long_random_setup_token

# CLI Credential Reset Override (Optional)
# Set to 'true' only if executing automated administrator password resets via script
ALLOW_ADMIN_RESET=false

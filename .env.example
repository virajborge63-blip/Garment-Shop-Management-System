# ========================================================
# Garment Shop Management System - Environment Variables (MongoDB)
# ========================================================

# Deployment Environment
NODE_ENV=production
PORT=3000

# MongoDB Database Connection URI
# For MongoDB Atlas (Cloud Production):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/garment_shop_erp?retryWrites=true&w=majority
#
# For Local MongoDB service:
# MONGODB_URI=mongodb://127.0.0.1:27017/garment_shop_erp
#
# Note: If MONGODB_URI is left blank or omitted, the application automatically
# spins up an embedded MongoDB engine (mongodb-memory-server) for zero-setup execution.
MONGODB_URI=mongodb://127.0.0.1:27017/garment_shop_erp

# Session and Security Secrets (Set to a long, cryptographically random secret string)
SESSION_SECRET=replace_with_a_secure_random_64_character_string_here

# Initial Super Admin (Store Owner) Setup
# The system automatically provisions the Super Admin account on initial boot IF no admin exists.
# Once created, server restarts will NEVER overwrite credentials.
ADMIN_EMAIL=hmrajpal11@gmail.com
ADMIN_PASSWORD=HMRajpal@89565
ADMIN_USERNAME=hmrajpal

# Protected Remote Setup Token (Optional)
# If provided, enables POST /api/auth/setup-admin for credential provisioning or recovery.
# If an admin already exists, this token is strictly required to authorize changes.
SETUP_TOKEN=replace_with_a_secure_token_for_admin_setup

# CLI Credential Reset Override (Optional)
# Set to 'true' only if executing automated administrator password resets via script
ALLOW_ADMIN_RESET=false

# ========================================================
# Garment Shop Management System - Environment Variables
# ========================================================

# Deployment Environment
NODE_ENV=production
PORT=3000

# SQLite Persistent Database Configuration
# Local development default:
DB_PATH=./erp_management.db

# Render Persistent Disk Mount:
# When mounting a Persistent Disk on Render at /var/data, set:
# DB_PATH=/var/data/erp_management.db

# Security & Session Encryption Secret
# Strong secret used to salt password hashes and protect sessions
SESSION_SECRET=your_long_random_session_secret_key_here

# Initial Super Admin Bootstrapping
# Configures the first Super Administrator if none exists in the database
ADMIN_EMAIL=hmrajapal11@gmail.com
ADMIN_PASSWORD=your_secure_owner_password_here
ADMIN_USERNAME=hmrajpal

# Protected Admin Setup Token (optional)
# Protects the /api/auth/setup-admin endpoint against unauthorized invocation
SETUP_TOKEN=your_secure_random_setup_token_here

# Google Gemini API Key (optional for AI capabilities)
GEMINI_API_KEY=MY_GEMINI_API_KEY

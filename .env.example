# ========================================================
# Garment Shop Management System - Environment Variables
# ========================================================

# Deployment Environment
NODE_ENV=production
PORT=3000

# SQLite Persistent Database Configuration
# Render Persistent Disk Mount: Mount path should be set to /var/data in the Render Dashboard
# Persistent disk path:
DB_PATH=/var/data/erp_management.db

# For local development (defaults to ./data/erp_management.db):
# DB_PATH=./data/erp_management.db

# Session and Security Secrets (Set to a long, cryptographically random secret string)
SESSION_SECRET=replace_with_a_secure_random_64_character_string_here

# Initial Super Admin (Store Owner) Setup
# The system will automatically create the Super Admin account on first boot IF no admin exists.
# Once created, server restarts will NEVER overwrite credentials.
ADMIN_EMAIL=owner@rajpalgarments.com
ADMIN_PASSWORD=change_this_to_a_strong_password_min_8_chars
ADMIN_USERNAME=owner_admin

# Protected Remote Setup Token (Optional)
# If provided, enables POST /api/auth/setup-admin for credential provisioning or recovery.
# If an admin already exists, this token is strictly required to authorize changes.
SETUP_TOKEN=replace_with_a_secure_token_for_admin_setup

# CLI Credential Reset Override (Optional)
# Set to 'true' only if executing automated administrator password resets via script
ALLOW_ADMIN_RESET=false
